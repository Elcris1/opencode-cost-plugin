{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "./"
  ],
  "providers": {
    "demo-openai": {
      "name": "Demo OpenAI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:1/v1",
        "apiKey": "local-fixture"
      },
      "models": {
        "demo-small": {
          "name": "Demo Small",
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "cost": {
            "input": 0.25,
            "output": 1.5,
            "cache": {
              "read": 0
            }
          }
        },
        "demo-unpriced": {
          "name": "Demo Unpriced",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "demo-anthropic": {
      "name": "Demo Anthropic",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:1/v1",
        "apiKey": "local-fixture"
      },
      "models": {
        "demo-large": {
          "name": "Demo Large",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "cost": [
            {
              "input": 3,
              "output": 15,
              "cache": {
                "read": 0.3,
                "write": 3.75
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 200000
              },
              "input": 6,
              "output": 22.5,
              "cache": {
                "read": 0.6,
                "write": 7.5
              }
            }
          ],
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        }
      }
    }
  },
  "model": "demo-openai/demo-small"
}
